{
  "name": "archipelago-json",
  "version": "1.0.0",
  "type": "module",
  "description": "Archipelago JSON Export Tools - A frontend-focused fork that exports Archipelago game logic to JSON and provides a web-based client with advanced tracking.",
  "main": "playwright.config.js",
  "directories": {
    "doc": "docs",
    "test": "test_json"
  },
  "scripts": {
    "test": "node scripts/test/run-tests.js",
    "test:headed": "node scripts/test/run-tests.js --headed",
    "test:debug": "node scripts/test/run-tests.js --debug",
    "test:ui": "node scripts/test/run-tests.js --ui",
    "test:multiclient": "TEST_GAME=${npm_config_game:-} TEST_SEED=${npm_config_seed:-} TEST_OUTPUT_DIR=${npm_config_output:-test_results/multiclient} playwright test test_json/e2e/multiclient.spec.js",
    "test:multiclient:headed": "TEST_GAME=${npm_config_game:-} TEST_SEED=${npm_config_seed:-} TEST_OUTPUT_DIR=${npm_config_output:-test_results/multiclient} playwright test test_json/e2e/multiclient.spec.js --headed",
    "test:multiclient:debug": "TEST_GAME=${npm_config_game:-} TEST_SEED=${npm_config_seed:-} TEST_OUTPUT_DIR=${npm_config_output:-test_results/multiclient} playwright test test_json/e2e/multiclient.spec.js --debug",
    "test:health": "node scripts/test/test-health-check.js",
    "test:analyze": "node scripts/test/analyze-test-results.js",
    "test:full-suite": "npm run test:health && npm test && npm run test:analyze",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:unit:coverage": "vitest run --coverage",
    "bench": "vitest bench",
    "bench:json": "vitest bench --outputJson=./benchmark-results.json",
    "dev": "python3 scripts/utils/dev-server-nocache.py",
    "dev:cache": "python3 -m http.server 8000",
    "docs": "jsdoc -c jsdoc.json",
    "docs:watch": "jsdoc -c jsdoc.json --watch",
    "build": "node scripts/build/bundle-frontend.js",
    "build:watch": "node scripts/build/bundle-frontend.js --watch",
    "build:dev": "node scripts/build/bundle-frontend.js --no-minify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeerInfinity/Archipelago.git",
    "directory": "JSONExport"
  },
  "keywords": [
    "archipelago",
    "json",
    "multiworld",
    "web-client",
    "game-tracking"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/PeerInfinity/Archipelago/issues"
  },
  "homepage": "https://github.com/PeerInfinity/Archipelago/tree/JSONExport#readme",
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@vitest/coverage-v8": "^4.0.15",
    "esbuild": "^0.27.2",
    "jsdoc": "^4.0.5",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "playwright": "^1.57.0"
  }
}
