{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Generic Archipelago Rules JSON Schema",
  "description": "Generic schema for rules.json files, adaptable for various games.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "description": "Version of the rules.json schema itself."
    },
    "game_name": {
      "type": "string",
      "description": "The name of the game."
    },
    "game_directory": {
      "type": "string",
      "description": "The world directory name for the game."
    },
    "archipelago_version": {
      "type": "string",
      "description": "Version of Archipelago used to generate the game."
    },
    "generation_seed": {
      "type": "integer",
      "description": "The seed used for game generation."
    },
    "player_names": {
      "type": "object",
      "description": "Mapping of player slot ID (string) to player name.",
      "patternProperties": {
        "^[0-9]+$": { "type": "string" }
      },
      "additionalProperties": false
    },
    "world_classes": {
      "type": "object",
      "description": "Mapping of player slot ID (string) to the world class name used.",
      "patternProperties": {
        "^[0-9]+$": { "type": "string" }
      },
      "additionalProperties": false
    },
    "regions": {
      "type": "object",
      "description": "Region data, keyed by player slot ID (string).",
      "patternProperties": {
        "^[0-9]+$": {
          "type": "object",
          "description": "Region definitions for a player, keyed by region name. Typically includes a 'Menu' region.",
          "patternProperties": {
            "^.*$": { "$ref": "#/$defs/region" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "dungeons": {
      "type": "object",
      "description": "Dungeon data, keyed by player slot ID (string). Optional.",
      "patternProperties": {
        "^[0-9]+$": {
          "type": "object",
          "description": "Dungeon definitions for a player, keyed by dungeon name.",
          "patternProperties": {
            "^.*$": { "$ref": "#/$defs/dungeon" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "start_regions": {
      "type": "object",
      "description": "Start region configurations, keyed by player slot ID (string).",
      "patternProperties": {
        "^[0-9]+$": { "$ref": "#/$defs/startRegionConfig" }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "object",
      "description": "Item definitions, keyed by player slot ID (string).",
      "patternProperties": {
        "^[0-9]+$": {
          "type": "object",
          "description": "Item definitions for a player, keyed by item name.",
          "patternProperties": {
            "^.*$": { "$ref": "#/$defs/itemDefinition" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "item_groups": {
      "type": "object",
      "description": "List of item group names, keyed by player slot ID (string).",
      "patternProperties": {
        "^[0-9]+$": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "itempool_counts": {
      "type": "object",
      "description": "Counts of each item in the player's item pool, keyed by player slot ID (string).",
      "patternProperties": {
        "^[0-9]+$": {
          "type": "object",
          "description": "Mapping of item name to its count in the pool.",
          "patternProperties": {
            "^.*$": { "type": "integer" }
          }
        }
      },
      "additionalProperties": false
    },
    "progression_mapping": {
      "type": "object",
      "description": "Mapping for progressive items, keyed by player slot ID (string). Optional.",
      "patternProperties": {
        "^[0-9]+$": {
          "type": "object",
          "description": "Progressive item definitions for a player, keyed by the base progressive item name.",
          "patternProperties": {
            "^.*$": { "$ref": "#/$defs/progressionMappingDetail" }
          }
        }
      },
      "additionalProperties": false
    },
    "starting_items": {
      "type": "object",
      "description": "List of starting items for each player, keyed by player slot ID (string).",
      "patternProperties": {
        "^[0-9]+$": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "world": {
      "type": "object",
      "description": "World data mirroring Archipelago's world structure, keyed by player slot ID (string). Contains game name, options, runtime attributes, slot_data, and web metadata.",
      "patternProperties": {
        "^[0-9]+$": {
          "type": "object",
          "properties": {
            "game": {
              "type": "string",
              "description": "Name of the game this world is for."
            },
            "slot_data": {
              "type": "object",
              "description": "Data from world.fill_slot_data() sent to the client."
            },
            "base_id": {
              "type": "integer",
              "description": "Base ID for item/location allocation."
            },
            "world_description": {
              "type": "string",
              "description": "World class docstring describing the game."
            },
            "web": {
              "type": "object",
              "description": "WebWorld metadata (mirrors Archipelago's world.web).",
              "properties": {
                "theme": {
                  "type": "string",
                  "description": "Theme for the game pages."
                },
                "tutorials": {
                  "type": "array",
                  "description": "List of tutorial guides.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": { "type": "string" },
                      "description": { "type": "string" },
                      "language": { "type": "string" },
                      "file_name": { "type": "string" },
                      "link": { "type": "string" },
                      "authors": { "type": "array", "items": { "type": "string" } }
                    }
                  }
                }
              }
            }
          },
          "required": ["game"],
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "exporter": {
      "type": "object",
      "description": "Exporter-specific settings, keyed by player slot ID (string). Contains processing flags and metadata not from the Archipelago world.",
      "patternProperties": {
        "^[0-9]+$": {
          "type": "object",
          "properties": {
            "rule_format": {
              "type": "object",
              "description": "Version metadata for the exported rules.",
              "properties": {
                "version": { "type": "string" }
              },
              "required": ["version"]
            },
            "assume_bidirectional_exits": {
              "type": "boolean",
              "description": "Whether region connections are bidirectional by default."
            },
            "use_resolved_items": {
              "type": "boolean",
              "description": "Whether to use resolved items in event processing."
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "description": "DEPRECATED: Use 'world' instead. Kept for backwards compatibility.",
      "patternProperties": {
        "^[0-9]+$": {
          "type": "object",
          "properties": {
            "game": {
              "type": "string",
              "description": "Name of the game these settings apply to."
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "game_info": {
      "type": "object",
      "description": "Game-specific information and accumulator patterns, keyed by player slot ID (string). Contains custom game data that doesn't fit in world/exporter sections.",
      "patternProperties": {
        "^[0-9]+$": {
          "type": "object",
          "properties": {
            "accumulator_rules": {
              "type": "array",
              "description": "Rules for computing accumulated values (e.g., coin counts)."
            },
            "prog_items_init": {
              "type": "object",
              "description": "Initial values for progressive item accumulators."
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "helpers": {
      "type": "object",
      "description": "Helper function definitions, keyed by player slot ID (string).",
      "patternProperties": {
        "^[0-9]+$": {
          "type": "object",
          "description": "Helper definitions for a player, keyed by helper name.",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "seed_name": {
      "type": "string",
      "description": "The seed name string for this generation."
    },
    "is_vanilla": {
      "type": "boolean",
      "description": "Whether item placements match the original non-randomized game. True for games where items are in their designed/intended locations."
    },
    "is_canonical": {
      "type": "boolean",
      "description": "Whether item placements are deterministically reproduced by the world generator. True for worldgen worlds generated with --canonical-seed."
    },
    "canonical_placements": {
      "type": "object",
      "description": "Canonical item placements for deterministic seed generation, keyed by player slot ID (string).",
      "patternProperties": {
        "^[0-9]+$": {
          "type": "object",
          "description": "Mapping of location name to placed item name.",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "game_name",
    "archipelago_version",
    "generation_seed",
    "player_names",
    "regions",
    "start_regions",
    "items",
    "item_groups",
    "itempool_counts",
    "world",
    "game_info"
  ],
  "$defs": {
    "rule": {
      "description": "A rule object in either AST format (has 'type' field) or Rule Builder format (has 'rule' field).",
      "oneOf": [
        { "$ref": "#/$defs/astRule" },
        { "$ref": "#/$defs/ruleBuilderRule" }
      ]
    },
    "ruleBuilderRule": {
      "description": "A Rule Builder rule object. Built-in rules include True_, False_, Has, HasAll, HasAny, HasGroup, HasAllCounts, HasFromList, CountItem, And, Or, CanReachRegion, CanReachLocation, OptionValue, Compare, Conditional, Constant. Game-specific helper rules use arbitrary names.",
      "type": "object",
      "properties": {
        "rule": {
          "type": "string",
          "description": "The rule type name (e.g., 'Has', 'And', 'True_') or a game-specific helper name."
        },
        "args": {
          "description": "Rule arguments. Object for named args (e.g., {\"item_name\": \"Sword\"}), array for positional args."
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" },
          "description": "Sub-rules for composite rules like 'And' and 'Or'."
        },
        "_original_ast_type": {
          "type": "string",
          "description": "Metadata: the original AST rule type before conversion."
        },
        "_converted_from_ast": {
          "type": "boolean",
          "description": "Metadata: whether this rule was converted from AST format."
        }
      },
      "required": ["rule"],
      "additionalProperties": true
    },
    "astRule": {
      "description": "An AST-format rule object defining access conditions.",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "value": { "description": "Used for 'constant' type." },
        "name": {
          "type": "string",
          "description": "Used for 'name' or 'helper' type."
        },
        "item": {
          "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/rule" }],
          "description": "Item name or a rule resolving to an item name for 'item_check', 'count_check'."
        },
        "group": {
          "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/rule" }],
          "description": "Group name or a rule resolving to a group name for 'group_check'."
        },
        "count": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "$ref": "#/$defs/rule" }
          ],
          "description": "Required count for 'count_check', 'group_check', or a rule resolving to a count."
        },
        "method": {
          "type": "string",
          "description": "Method name for 'state_method'."
        },
        "args": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" },
          "description": "Positional arguments for 'helper', 'state_method', 'function_call'."
        },
        "kwargs": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/rule" },
          "description": "Keyword arguments for 'helper' type. Keys are parameter names, values are rule objects."
        },
        "conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" },
          "description": "Sub-rules for 'and', 'or'."
        },
        "left": {
          "$ref": "#/$defs/rule",
          "description": "Left operand for 'compare' or 'binary_op'."
        },
        "op": {
          "type": "string",
          "description": "Operator for 'compare' or 'binary_op'."
        },
        "right": {
          "$ref": "#/$defs/rule",
          "description": "Right operand for 'compare' or 'binary_op'."
        },
        "object": {
          "$ref": "#/$defs/rule",
          "description": "Object for 'attribute'."
        },
        "attr": {
          "type": "string",
          "description": "Attribute name for 'attribute'."
        },
        "index": {
          "$ref": "#/$defs/rule",
          "description": "Index for 'subscript'."
        },
        "function": {
          "$ref": "#/$defs/rule",
          "description": "Function reference for 'function_call'."
        },
        "test": {
          "$ref": "#/$defs/rule",
          "description": "Test condition for 'conditional'."
        },
        "if_true": {
          "oneOf": [{ "$ref": "#/$defs/rule" }, { "type": "null" }],
          "description": "Result if test is true for 'conditional'."
        },
        "if_false": {
          "oneOf": [{ "$ref": "#/$defs/rule" }, { "type": "null" }],
          "description": "Result if test is false for 'conditional'."
        },
        "condition": {
          "$ref": "#/$defs/rule",
          "description": "Condition for 'not'."
        },
        "operand": {
          "$ref": "#/$defs/rule",
          "description": "Operand for 'not' or 'negate' types."
        },
        "element_rule": {
          "$ref": "#/$defs/rule",
          "description": "Rule for each element in 'all_of' or 'any_of'."
        },
        "iterator_info": {
          "type": "object",
          "properties": {
            "type": { "const": "comprehension_details" },
            "target": { "$ref": "#/$defs/rule" },
            "iterator": { "$ref": "#/$defs/rule" }
          },
          "required": ["type", "target", "iterator"],
          "description": "Iterator details for 'all_of' or 'any_of'."
        },
        "region": {
          "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/rule" }],
          "description": "Region name for 'can_reach', 'region_reference', 'region_attribute'."
        },
        "entrance": {
          "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/rule" }],
          "description": "Entrance name for 'can_reach_entrance'."
        },
        "location": {
          "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/rule" }],
          "description": "Location name for 'location_check', 'placement_lookup'."
        },
        "setting": {
          "type": "string",
          "description": "Setting name for 'setting_value' (legacy)."
        },
        "option": {
          "type": "string",
          "description": "Option name for 'option_value' type."
        },
        "attribute": {
          "type": "string",
          "description": "Attribute name for 'world_attribute' type."
        },
        "capability": {
          "type": "string",
          "description": "Capability name for 'capability' type."
        },
        "statements": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" },
          "description": "Statements for 'block' type."
        },
        "body": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" },
          "description": "Body statements for 'for_range', 'for_iter', 'if_statement'."
        },
        "orelse": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" },
          "description": "Else branch for 'if_statement'."
        },
        "var": {
          "type": "string",
          "description": "Loop variable name for 'for_range', 'for_iter'."
        },
        "iterable": {
          "$ref": "#/$defs/rule",
          "description": "Iterable expression for 'for_iter'."
        },
        "parts": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" },
          "description": "Parts for 'f_string' type."
        },
        "elements": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" },
          "description": "Elements for 'tuple' type."
        },
        "player": {
          "oneOf": [{ "type": "integer" }, { "$ref": "#/$defs/rule" }],
          "description": "Player ID for 'placement_search'."
        },
        "locations": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Location names for 'placement_search'."
        },
        "items": {
          "type": "array",
          "items": { "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/rule" }] },
          "description": "Item names or rules for 'counts' type (check if total count of items >= required amount)."
        }
      },
      "required": ["type"]
    },
    "region": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "exits": { "type": "array", "items": { "$ref": "#/$defs/exit" } },
        "locations": {
          "type": "array",
          "items": { "$ref": "#/$defs/location" }
        },
        "shop": {
          "$ref": "#/$defs/shop",
          "description": "Shop data if this region contains a shop. Optional."
        }
      },
      "required": [
        "name",
        "exits",
        "locations"
      ],
      "additionalProperties": true
    },
    "exit": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "connected_region": { "type": "string" },
        "access_rule": {
          "oneOf": [{ "$ref": "#/$defs/rule" }, { "type": "null" }]
        }
      },
      "required": ["name", "connected_region"]
    },
    "location": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "id": {
          "type": ["integer", "null"],
          "description": "Archipelago Location ID. Null for internally generated locations."
        },
        "access_rule": {
          "oneOf": [{ "$ref": "#/$defs/rule" }, { "type": "null" }]
        },
        "item_rule": {
          "oneOf": [{ "$ref": "#/$defs/rule" }, { "type": "null" }],
          "description": "Rule for the item at this location."
        },
        "item": {
          "$ref": "#/$defs/itemPlacement",
          "description": "The item placed at this location."
        }
      },
      "required": ["name", "id", "access_rule"],
      "additionalProperties": true
    },
    "itemPlacement": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "player": { "type": "integer" },
        "advancement": { "type": "boolean" },
        "type": {
          "type": ["string", "integer", "null"],
          "description": "Item type classification. String or integer depending on exporter version."
        }
      },
      "required": ["name", "player", "advancement", "type"]
    },
    "shop": {
      "type": "object",
      "properties": {
        "type": { "type": "integer", "description": "Shop type identifier." },
        "inventory": {
          "type": "array",
          "items": { "$ref": "#/$defs/shopItem" }
        },
        "locked": {
          "type": "boolean",
          "description": "Whether the shop is initially locked."
        },
        "region_name": {
          "type": ["string", "null"],
          "description": "Name of the region the shop is in."
        },
        "location_name": {
          "type": ["string", "null"],
          "description": "Name of the location representing this shop."
        }
      },
      "required": ["type", "inventory", "locked"]
    },
    "shopItem": {
      "type": "object",
      "properties": {
        "item": {
          "type": ["string", "null"],
          "description": "Name of the item for sale."
        },
        "price": { "type": "integer" },
        "max": {
          "type": "integer",
          "description": "Maximum number of this item that can be bought (0 often means unlimited)."
        },
        "replacement": {
          "type": ["string", "null"],
          "description": "Item that replaces this slot after purchase (if any)."
        },
        "replacement_price": {
          "type": ["integer", "null"],
          "description": "Price of the replacement item."
        }
      },
      "required": ["item", "price", "max"]
    },
    "dungeon": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "regions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of region names belonging to this dungeon."
        },
        "bosses": {
          "type": "object",
          "description": "Boss definitions for this dungeon, keyed by boss position (e.g., 'bottom', 'middle', 'top'). For single-boss dungeons, a single key like 'boss' or 'main' may be used.",
          "patternProperties": {
            "^.*$": { "$ref": "#/$defs/boss" }
          },
          "additionalProperties": false
        },
        "medallion_check": {
          "oneOf": [{ "$ref": "#/$defs/rule" }, { "type": "null" }],
          "description": "Rule for checking the medallion requirement for this dungeon."
        }
      },
      "required": ["name", "regions"]
    },
    "boss": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "defeat_rule": {
          "oneOf": [{ "$ref": "#/$defs/rule" }, { "type": "null" }],
          "description": "Rule for defeating this boss."
        }
      },
      "required": ["name"]
    },
    "itemDefinition": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "id": {
          "oneOf": [
            { "type": "integer" },
            { "type": "null" },
            {
              "type": "array",
              "items": { "type": "integer" },
              "description": "Array of Archipelago Item IDs for composite items."
            }
          ],
          "description": "Archipelago Item ID. Can be a single integer, null, or an array of integers for composite items like pendants and crystals."
        },
        "groups": { "type": "array", "items": { "type": "string" } },
        "classification": {
          "type": "string",
          "description": "Item classification string (e.g., 'progression', 'useful', 'trap', 'filler', 'progression_skip_balancing')."
        },
        "advancement": {
          "type": "boolean",
          "description": "Legacy: whether item is progression. Replaced by 'classification' in newer exports."
        },
        "useful": {
          "type": "boolean",
          "description": "Legacy: whether item is useful. Replaced by 'classification' in newer exports."
        },
        "trap": {
          "type": "boolean",
          "description": "Legacy: whether item is a trap. Replaced by 'classification' in newer exports."
        },
        "event": { "type": "boolean" },
        "type": {
          "type": ["string", "null"],
          "description": "Generic item type."
        },
        "max_count": {
          "type": "integer",
          "description": "Maximum count of this item."
        },
        "hint_text": {
          "type": "string",
          "description": "Hint text for this item. Optional, only present for some games."
        },
        "classification_counts": {
          "type": "object",
          "description": "Counts per classification when multiple copies of an item exist with different classifications.",
          "patternProperties": {
            "^.*$": { "type": "integer" }
          },
          "additionalProperties": false
        }
      },
      "required": ["name"],
      "additionalProperties": true
    },
    "progressionMappingDetail": {
      "type": "object",
      "properties": {
        "items": {
          "oneOf": [
            {
              "type": "array",
              "items": { "$ref": "#/$defs/progressiveItemLevel" }
            },
            {
              "type": "object",
              "description": "Mapping of item name to count (alternative format used by some games).",
              "additionalProperties": { "type": "integer" }
            }
          ]
        },
        "base_item": {
          "type": "string",
          "description": "The name of the base progressive item."
        }
      },
      "required": ["items", "base_item"]
    },
    "progressiveItemLevel": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the item granted at this level."
        },
        "level": {
          "type": "integer",
          "description": "The level of progression this item represents."
        },
        "provides": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Other items this level might also grant."
        }
      },
      "required": ["name", "level"]
    },
    "startRegionConfig": {
      "type": "object",
      "properties": {
        "default": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Default starting region(s)."
        },
        "available": {
          "type": "array",
          "items": { "$ref": "#/$defs/availableStartRegion" },
          "description": "List of available start regions."
        }
      },
      "required": ["default", "available"]
    },
    "availableStartRegion": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "oneOf": [{ "type": "integer" }, { "type": "string" }] }
      },
      "required": ["name", "type"]
    }
  }
}
